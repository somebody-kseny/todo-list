{
    "include": ["./src/**/*"],
    "compilerOptions": {
        "noImplicitAny": true,
        "module": "es6",
        "target": "es6",
        "lib": ["ES5", "ES2023", "dom"],
        "jsx": "react",
        "allowJs": true,
        "outDir": "./dist",
        "moduleResolution": "node",
        "baseUrl": "src",
        "paths": {
            "@components/*": ["./components/*"],
            "@projectTypes/*": ["./types/*"]
        }
    }
}
